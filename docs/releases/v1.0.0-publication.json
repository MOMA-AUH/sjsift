  "reproduction_helpers": {
    "check_catalog.py": "\"\"\"Check published CLI against independent TSV expectations from tagged TOML.\"\"\"\nimport csv\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport tomllib\n\nroot = Path(__file__).resolve().parent\ncatalog = root / 'assets/grch38-v1.0.0.toml'\noutput = root / 'catalog-check'\noutput.mkdir()\ndata = tomllib.loads(catalog.read_text())\nkeys = ('chromosome', 'intron_start', 'intron_end', 'strand')\nsupports = {}\nfor variant in data['variants']:\n    for junction in [variant, *variant.get('reference_junctions', [])]:\n        key = tuple(junction[k] for k in keys)\n        if key not in supports:\n            index = len(supports)\n            supports[key] = (0, 0) if index % 5 == 0 else (index + 1, index % 3)\nstar = output / 'synthetic.SJ.out.tab'\nstar.write_text(''.join('\\t'.join(map(str, [*key[:3], {'+': 1, '-': 2}[key[3]], 1, 0, *value, 50])) + '\\n' for key, value in reversed(supports.items()) if sum(value)))\ncommand = [str(Path(sys.executable).parent / 'sjsift'), '--sample-name', 'publication-synthetic', '--definitions', str(catalog), '--junctions', str(star)]\nsubprocess.run([*command, '--output', str(output/'main.tsv'), '--context-output', str(output/'context.tsv'), '--html-output', str(output/'report.html'), '--provenance-output', str(output/'provenance.json')], check=True)\nheader = ['variant_id', 'genome_assembly', *keys, 'unique_support', 'multimapping_support', 'total_support']\nexpected_main = [header]\nexpected_context = [[*header[:2], 'context_role', *header[2:]]]\nfor v in data['variants']:\n    key = tuple(v[k] for k in keys)\n    counts = supports[key]\n    expected_main.append([v['id'], data['genome_assembly'], *key, *counts, sum(counts)])\n    for reference in v.get('reference_junctions', []):\n        key = tuple(reference[k] for k in keys)\n        counts = supports[key]\n        expected_context.append([v['id'], data['genome_assembly'], reference['role'], *key, *counts, sum(counts)])\nfor name, rows in [('main', expected_main), ('context', expected_context)]:\n    stream = io.StringIO()\n    csv.writer(stream, delimiter='\\t', lineterminator='\\n').writerows(rows)\n    assert (output/f'{name}.tsv').read_bytes() == stream.getvalue().encode()\nsubprocess.run([*command, '--output', str(output/'repeat.tsv'), '--provenance-output', str(output/'repeat.json')], check=True)\nassert (output/'repeat.tsv').read_bytes() == (output/'main.tsv').read_bytes()\nassert (output/'repeat.json').read_bytes() == (output/'provenance.json').read_bytes()\np = json.loads((output/'provenance.json').read_text())\nassert p['schema_version'] == 1 and p['software']['version'] == '1.0.0'\nassert p['catalog']['sha256'] == hashlib.sha256(catalog.read_bytes()).hexdigest() == 'a532f7bf56618991d403d7b3c87fc2d398d4203695b127caab68e8874c557ba3'\nassert p['star_input']['sha256'] == hashlib.sha256(star.read_bytes()).hexdigest()\nhtml = (output/'report.html').read_text()\nassert '<style>' in html and '<script>' in html and '<script src=' not in html\nassert len(expected_main) == 18 and len(expected_context) == 33\nprint(json.dumps({'variant_rows': 17, 'reference_rows': 32, 'distinct_junctions': len(supports), 'both_tsv_bytes_and_order': 'passed', 'zero_support_rows': 'passed', 'provenance_repeat_bytes': 'passed', 'embedded_html_assets': 'passed'}))\n"
  },
